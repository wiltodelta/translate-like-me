.build/
Translate Like Me.app/
*.app/
.DS_Store
*.xcodeproj
.swiftpm/

# Other harnesses' generated config. Claude's sync owns these; a committed copy
# is a second source nobody reconciles. Anchored so a same-named source file
# deeper in the tree is not caught.
/.agents/
/.codex/
/.opencode/
/opencode.json
/opencode.jsonc

# Local Claude Code settings, never shared
.claude/settings.local.json

# An empty plist that appears next to AppIcon.icon now and then. Not written by
# swift build, swift test, build.sh, actool or its ibtoold agent (checked
# 2026-09-23); the source is still unknown, so it is ignored, not explained.
/Resources/Assets.plist

# Release zips built by notarize.sh
/TranslateLikeMe-v*-macOS.zip
