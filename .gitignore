.build/
Translate Like Me.app/
*.app/
.DS_Store
*.xcodeproj
.swiftpm/

# Other harnesses' generated config. Claude's sync owns these; a committed copy
# is a second source nobody reconciles. Anchored so a same-named source file
# deeper in the tree is not caught.
/.agents/
/.codex/
/.opencode/
/opencode.json
/opencode.jsonc

# Local Claude Code settings, never shared
.claude/settings.local.json

# An empty plist that appeared next to AppIcon.icon now and then: actool's
# long-lived agent resolves relative paths against the directory it first started
# in, and watch-me-sleep's old generate-assets.sh passed a relative
# `--output-partial-info-plist Resources/Assets.plist` while the agent had started
# here (found 2026-09-24). Both build scripts now pass absolute paths.
/Resources/Assets.plist

# Release zips built by notarize.sh
/Translate-Like-Me-v*-macOS.zip
