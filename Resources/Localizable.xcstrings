    "%@ Needs Accessibility permission (macOS will ask)." : {
      "comment" : "The placeholder is the explanation of language pairs, a few sentences",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Benötigt Zugriff auf die Bedienungshilfen (macOS fragt danach)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Requiere el permiso de Accesibilidad (macOS lo solicitará)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nécessite l’autorisation Accessibilité (macOS vous la demandera)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Richiede l'autorizzazione per Accessibilità (macOS te la chiederà)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@アクセシビリティの許可が必要です（macOSが確認を求めます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 손쉬운 사용 권한이 필요합니다. macOS에서 허용 여부를 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Requer permissão de Acessibilidade (o macOS pedirá)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Требуется разрешение на универсальный доступ (macOS запросит его)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@需要无障碍权限（macOS 会向你请求）。"
          }
        }
      }
    },
    "%@ is not downloaded yet. Download it in Settings > Translation." : {
      "comment" : "The placeholder is a model name, such as TranslateGemma 12B",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist noch nicht geladen. Lade es unter „Einstellungen“ > „Übersetzung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no se ha descargado. Descárgalo en Ajustes > Traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas encore téléchargé. Téléchargez-le dans Réglages > Traduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è ancora stato scaricato. Scaricalo in Impostazioni > Traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はまだダウンロードされていません。「設定」>「翻訳」でダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 아직 다운로드되지 않았습니다. 설정 > 번역에서 다운로드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não foi baixado. Baixe-o em Ajustes > Tradução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ещё не загружена. Загрузите её в разделе «Настройки» > «Перевод»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未下载 %@。请在“设置”>“翻译”中下载。"
          }
        }
      }
    },
    "%@ needs a Mac with at least %lld GB of memory. Choose a smaller model in Settings > Translation." : {
      "comment" : "The first placeholder is a model name, the second a number of gigabytes",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ braucht einen Mac mit mindestens %2$lld GB Arbeitsspeicher. Wähle unter „Einstellungen“ > „Übersetzung“ ein kleineres Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ needs a Mac with at least %2$lld GB of memory. Choose a smaller model in Settings > Translation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ necesita un Mac con al menos %2$lld GB de memoria. Elige un modelo más pequeño en Ajustes > Traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nécessite un Mac avec au moins %2$lld Go de mémoire. Choisissez un modèle plus petit dans Réglages > Traduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ richiede un Mac con almeno %2$lld GB di memoria. Scegli un modello più piccolo in Impostazioni > Traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には%2$lld GB以上のメモリを搭載したMacが必要です。「設定」>「翻訳」で小さいモデルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 메모리가 %2$lldGB 이상인 Mac이 필요합니다. 설정 > 번역에서 더 작은 모델을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ precisa de um Mac com pelo menos %2$lld GB de memória. Escolha um modelo menor em Ajustes > Tradução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для %1$@ нужен Mac с памятью не менее %2$lld ГБ. Выберите модель поменьше в разделе «Настройки» > «Перевод»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 需要至少配备 %2$lld GB 内存的 Mac。请在“设置”>“翻译”中选择较小的模型。"
          }
        }
      }
    },
    "%@ will be removed from this Mac. You can download it again later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird von diesem Mac entfernt. Du kannst das Modell später erneut herunterladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se eliminará de este Mac. Puedes volver a descargarlo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sera supprimé de ce Mac. Vous pourrez le télécharger à nouveau plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verrà rimosso da questo Mac. Potrai scaricarlo di nuovo in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をこのMacから削除します。後で再度ダウンロードできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 모델이 이 Mac에서 삭제됩니다. 나중에 다시 다운로드할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ será removido deste Mac. Você poderá baixá-lo novamente depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модель %@ будет удалена с этого Mac. Её можно загрузить снова."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将从这台 Mac 上移除。你可以稍后重新下载。"
          }
        }
      }
    },
