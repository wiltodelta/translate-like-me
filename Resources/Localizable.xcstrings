    "Speech couldn't be recognized. Try dictating again, or prepare dictation again in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spracheingabe wurde nicht erkannt. Diktiere erneut oder bereite Diktieren in den Einstellungen erneut vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido reconocer el habla. Vuelve a dictar o prepara de nuevo el dictado en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de reconnaître la parole. Réessayez de dicter ou relancez la préparation de la dictée dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile riconoscere il parlato. Prova a dettare di nuovo o prepara di nuovo la dettatura in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声を認識できませんでした。もう一度音声入力するか、設定で音声入力をもう一度準備してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성을 인식할 수 없습니다. 다시 받아쓰거나 설정에서 받아쓰기를 다시 준비하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
