    "Press left or right Option. Delete clears, Esc cancels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linke oder rechte Wahltaste drücken. Löschtaste entfernt, Esc bricht ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa Opción izquierda o derecha. Eliminar borra, Esc cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur Option gauche ou droite. Supprimer efface, Échap annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi Opzione sinistro o destro. Elimina rimuove, Esc annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右どちらかのOptionキーを押します。Deleteで消去、Escでキャンセルします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "왼쪽 또는 오른쪽 Option 키를 누르십시오. Delete 키로 지우고 Esc 키로 취소합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione Option esquerda ou direita. Delete apaga, Esc cancela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите левую или правую клавишу Option. Delete очищает, Esc отменяет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下左侧或右侧 Option 键。按 Delete 键清除，按 Esc 键取消。"
          }
        }
      }
    },
