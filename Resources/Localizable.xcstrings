    "You can change models, languages and everything else in Settings. Open it from the Translate Like Me icon in the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle, Sprachen und weitere Optionen kannst du in den Einstellungen ändern. Öffne sie über das Translate Like Me-Symbol in der Menüleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar modelos, idiomas y demás opciones en Ajustes. Ábrelos desde el icono de Translate Like Me en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
