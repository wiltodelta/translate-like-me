    },
    "Free at least 8 GB of disk space, then prepare dictation again in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib mindestens 8 GB Speicherplatz frei und bereite Diktieren dann in den Einstellungen erneut vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera al menos 8 GB de espacio en disco y vuelve a preparar el dictado en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez au moins 8 Go d’espace disque, puis relancez la préparation de la dictée dans les réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera almeno 8 GB di spazio su disco, poi prepara di nuovo la dettatura in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8 GB以上のディスク領域を空けてから、設定で音声入力をもう一度準備してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 공간을 8GB 이상 확보한 다음 설정에서 받아쓰기를 다시 준비하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libere pelo menos 8 GB de espaço em disco e prepare o ditado novamente nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освободите не менее 8 ГБ на диске, затем повторите подготовку диктовки в настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
