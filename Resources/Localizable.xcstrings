    "Recording stopped unexpectedly. Check your microphone, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wurde unerwartet beendet. Prüfe dein Mikrofon und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se ha detenido inesperadamente. Comprueba el micrófono e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement s’est arrêté de façon inattendue. Vérifiez votre micro, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione si è interrotta inaspettatamente. Controlla il microfono, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音が予期せず停止しました。マイクを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음이 예기치 않게 중단되었습니다. 마이크를 확인한 다음 다시 시도하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação parou inesperadamente. Verifique o microfone e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись неожиданно остановилась. Проверьте микрофон и повторите попытку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音意外停止。请检查麦克风，然后重试。"
          }
        }
      }
    },
