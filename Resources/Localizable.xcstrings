    "Free at least %@ of disk space, then download again." : {
      "comment" : "The placeholder is an amount of disk space, such as 8.7 GB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib mindestens %@ Speicherplatz frei und lade dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera al menos %@ de espacio en disco y vuelve a descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libérez au moins %@ d’espace disque, puis relancez le téléchargement."
