    "The most accurate, writing styles and Rewrite included. About 7 GB to download, needs 16 GB of memory." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am genauesten, auch mit Schreibstil und beim Umschreiben. Etwa 7 GB Download, braucht 16 GB Arbeitsspeicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El más preciso, también con estilo de escritura y al reescribir. Unos 7 GB de descarga; necesita 16 GB de memoria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus précis, y compris avec un style d’écriture et pour la réécriture. Environ 7 Go à télécharger, nécessite 16 Go de mémoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più preciso, anche con lo stile di scrittura e nella riscrittura. Download di circa 7 GB, richiede 16 GB di memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最も正確で、文体の指定や書き直しにも対応します。ダウンロードは約7 GB、16 GBのメモリが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가장 정확하며 글쓰기 스타일과 다시 쓰기에도 잘 맞습니다. 다운로드 크기 약 7GB, 메모리 16GB가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais preciso, inclusive com estilo de escrita e ao reescrever. Cerca de 7 GB para baixar; precisa de 16 GB de memória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самая точная, в том числе со стилем письма и при переписывании. Загрузка около 7 ГБ, нужно 16 ГБ памяти."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
