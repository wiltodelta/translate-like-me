    "%@ Needs Accessibility permission (macOS will ask)." : {
      "comment" : "The placeholder is the explanation of language pairs, a few sentences",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Benötigt Zugriff auf die Bedienungshilfen (macOS fragt danach)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Requiere el permiso de Accesibilidad (macOS lo solicitará)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Nécessite l’autorisation Accessibilité (macOS vous la demandera)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Richiede l'autorizzazione per Accessibilità (macOS te la chiederà)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@アクセシビリティの許可が必要です（macOSが確認を求めます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 손쉬운 사용 권한이 필요합니다. macOS에서 허용 여부를 묻습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Requer permissão de Acessibilidade (o macOS pedirá)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Требуется разрешение на универсальный доступ (macOS запросит его)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@需要无障碍权限（macOS 会向你请求）。"
          }
        }
      }
    },
    "%@ is not downloaded yet. Download it in Settings > Translation." : {
      "comment" : "The placeholder is a model name, such as TranslateGemma 12B",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist noch nicht geladen. Lade es unter „Einstellungen“ > „Übersetzung“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no se ha descargado. Descárgalo en Ajustes > Traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas encore téléchargé. Téléchargez-le dans Réglages > Traduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non è ancora stato scaricato. Scaricalo in Impostazioni > Traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はまだダウンロードされていません。「設定」>「翻訳」でダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 아직 다운로드되지 않았습니다. 설정 > 번역에서 다운로드하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não foi baixado. Baixe-o em Ajustes > Tradução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ещё не загружена. Загрузите её в разделе «Настройки» > «Перевод»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未下载 %@。请在“设置”>“翻译”中下载。"
          }
        }
      }
    },
    "%@ needs a Mac with at least %lld GB of memory. Choose a smaller model in Settings > Translation." : {
      "comment" : "The first placeholder is a model name, the second a number of gigabytes",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ braucht einen Mac mit mindestens %2$lld GB Arbeitsspeicher. Wähle unter „Einstellungen“ > „Übersetzung“ ein kleineres Modell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ needs a Mac with at least %2$lld GB of memory. Choose a smaller model in Settings > Translation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ necesita un Mac con al menos %2$lld GB de memoria. Elige un modelo más pequeño en Ajustes > Traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ nécessite un Mac avec au moins %2$lld Go de mémoire. Choisissez un modèle plus petit dans Réglages > Traduction."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ richiede un Mac con almeno %2$lld GB di memoria. Scegli un modello più piccolo in Impostazioni > Traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@には%2$lld GB以上のメモリを搭載したMacが必要です。「設定」>「翻訳」で小さいモデルを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 메모리가 %2$lldGB 이상인 Mac이 필요합니다. 설정 > 번역에서 더 작은 모델을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ precisa de um Mac com pelo menos %2$lld GB de memória. Escolha um modelo menor em Ajustes > Tradução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для %1$@ нужен Mac с памятью не менее %2$lld ГБ. Выберите модель поменьше в разделе «Настройки» > «Перевод»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 需要至少配备 %2$lld GB 内存的 Mac。请在“设置”>“翻译”中选择较小的模型。"
          }
        }
      }
    },
    "About three times faster, and lighter. About 3.6 GB to download. Less accurate: it can translate a third language into the wrong one of your pair, and in Rewrite keep a detail you corrected while speaking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa dreimal schneller und leichter. Etwa 3,6 GB Download. Weniger genau: Es kann eine dritte Sprache in die falsche Sprache deines Paares übersetzen und beim Umschreiben ein Detail behalten, das du beim Sprechen korrigiert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unas tres veces más rápido y más ligero. Unos 3,6 GB de descarga. Menos preciso: puede traducir un tercer idioma al idioma equivocado de tu par y, al reescribir, conservar un detalle que corregiste al hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ trois fois plus rapide, et plus léger. Environ 3,6 Go à télécharger. Moins précis : il peut traduire une troisième langue dans la mauvaise langue de votre paire et, en réécriture, garder un détail que vous avez corrigé en parlant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa tre volte più veloce e più leggero. Download di circa 3,6 GB. Meno preciso: può tradurre una terza lingua nella lingua sbagliata della coppia e, nella riscrittura, mantenere un dettaglio che hai corretto parlando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "約3倍速く、軽量です。ダウンロードは約3.6 GBです。精度は低めで、第3の言語をペアの誤った言語に翻訳したり、書き直しで話しながら訂正した内容を残したりすることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약 3배 빠르고 가볍습니다. 다운로드 크기 약 3.6GB. 정확도가 낮아 제3의 언어를 쌍의 잘못된 언어로 번역하거나, 다시 쓰기에서 말하면서 정정한 내용을 남길 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de três vezes mais rápido e mais leve. Cerca de 3,6 GB para baixar. Menos preciso: pode traduzir um terceiro idioma para o idioma errado do seu par e, ao reescrever, manter um detalhe que você corrigiu enquanto falava."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примерно втрое быстрее и легче. Загрузка около 3,6 ГБ. Менее точная: может перевести третий язык не на тот язык пары, а при переписывании оставить деталь, которую вы поправили по ходу речи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "速度约快三倍，也更轻量。需下载约 3.6 GB。准确度较低：可能把第三种语言译成语言对中错误的那一种，改写时也可能保留你在口述中已更正的细节。"
          }
        }
      }
    },
