    },
    "Needs ⌘, ⌥, or ⌃. Delete clears, Esc cancels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert ⌘, ⌥ oder ⌃. Löschtaste entfernt, Esc bricht ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere ⌘, ⌥ o ⌃. Eliminar borra, Esc cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiert ⌘, ⌥ ou ⌃. Supprimer efface, Échap annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede ⌘, ⌥ o ⌃. Elimina rimuove, Esc annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘、⌥、⌃のいずれかが必要です。Deleteで消去、Escでキャンセルします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘, ⌥ 또는 ⌃ 키가 필요합니다. Delete 키로 지우고 Esc 키로 취소합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requer ⌘, ⌥ ou ⌃. Delete apaga, Esc cancela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нужна клавиша ⌘, ⌥ или ⌃. Delete очищает, Esc отменяет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需包含 ⌘、⌥ 或 ⌃。按 Delete 键清除，按 Esc 键取消。"
          }
        }
      }
    },
    "No language pairs yet. Add one to get a translation shortcut." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Sprachpaare. Füge eins hinzu, um einen Übersetzungskurzbefehl zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay pares de idiomas. Añade uno para tener un atajo de traducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune paire de langues pour l’instant. Ajoutez-en une pour obtenir un raccourci de traduction."
          }
